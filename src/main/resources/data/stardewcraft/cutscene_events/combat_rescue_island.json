{
  "id": "combat_rescue_island",
  "skippable": false,
  "trigger": { "type": "manual" },
  "preconditions": [],
  "commands": [
    { "cmd": "comment", "text": "=== SDV Data/Events/IslandSouth:PlayerKilled ===" },
    { "cmd": "comment", "text": "PENDING AUTHORING: I01-I03 below are explicit development fallbacks, not captured Minecraft points" },
    { "cmd": "lock_player" },
    { "cmd": "fade", "mode": "out", "ticks": 10 },

    { "cmd": "spawn_actor", "actor": "fake_player", "npc_id": "player",
      "x": 13, "y": 64, "z": 33, "relative": false, "facing": 0 },
    { "cmd": "animate", "actor": "fake_player", "anim": "collapsed", "loop": true },

    { "cmd": "spawn_actor", "actor": "rescuer", "npc_id": "$combat_rescuer",
      "x": 15, "y": 64, "z": 33, "relative": false, "facing": 90 },

    { "cmd": "camera", "x": 13, "y": 66, "z": 37,
      "yaw": 180, "pitch": 20, "relative": false },
    { "cmd": "fade", "mode": "in", "ticks": 20 },

    { "cmd": "pause", "ticks": 75 },
    { "cmd": "message", "text": "event.combat_rescue.wake_first" },
    { "cmd": "pause", "ticks": 50 },
    { "cmd": "message", "text": "event.combat_rescue.wake_second" },
    { "cmd": "pause", "ticks": 50 },

    { "cmd": "speak", "npc_id": "$combat_rescuer", "text": "$combat_rescuer_dialogue" },

    { "cmd": "animate", "actor": "fake_player", "anim": "idle", "loop": false },
    { "cmd": "pause", "ticks": 50 },
    { "cmd": "emote", "actor": "fake_player", "emote": "sad" },
    { "cmd": "pause", "ticks": 30 },
    { "cmd": "end" }
  ]
}
